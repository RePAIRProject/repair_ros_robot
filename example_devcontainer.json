{
    "name": "ROS Development Container",
    //"privileged": true,
    //"remoteUser": "${localEnv:USER}",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "${localEnv:USER}",
            "DOCKER_REPO": "osrf/ros",
            "ROS_DISTRO": "noetic",
            "IMAGE_SUFFIX": "-desktop-full"
        }
    },
    "workspaceFolder": "/home/ws",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/ws,type=bind",
    "customizations": {
        "vscode": {
            "extensions":[
                //"ms-vscode.cpptools",
                //"ms-vscode.cpptools-themes",
                "twxs.cmake",
                "donjayamanne.python-extension-pack",
                "eamodio.gitlens",
                "ms-iot.vscode-ros"
            ]
        }
    },
    "containerEnv": {
        "DISPLAY": "unix:0",
        "ROS_LOCALHOST_ONLY": "1",
        "ROS_DOMAIN_ID": "42"
    },
    "runArgs": [
        "--privileged",
        "--net=host",
        "--ipc=host",
        "--pid=host",
        "-e", "DISPLAY=${env:DISPLAY}",
        "--gpus", "all",
        //"--device=/dev/bus/usb/002/002",     // Replace if your bus/device changes
        "--volume=/tmp/.X11-unix:/tmp/.X11-unix"
        //"--volume=/run/udev:/run/udev"
        ],
    "mounts": [
        //"source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
        "source=/dev/dri,target=/dev/dri,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.ssh,target=/home/${localEnv:USER}/.ssh,type=bind"
    ],
    "postCreateCommand": "sh ./.devcontainer/postCreate.sh"
}
